{
  "name": "claude-agent-sdk-learning",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node scripts/dev-server.mjs",
    "test:dev-server": "node --test scripts/dev-server.test.mjs",
    "dev:web": "vite",
    "test:offline": "node --import tsx --test server/testing/offline.test.ts server/testing/routes.test.ts server/evals/evals.test.ts server/debugging/debugging.test.ts server/tool-design/tool-design.test.ts server/upgrading/upgrading.test.ts server/teams/teams.test.ts server/worktrees/worktrees.test.ts server/tool-search/tool-search.test.ts server/routing/routing.test.ts server/durable/durable.test.ts server/agent-mcp/agent-mcp.test.ts server/retrieval/retrieval.test.ts server/database/database.test.ts server/browser/browser.test.ts server/approval/approval.test.ts server/realtime/realtime.test.ts server/saas/saas.test.ts server/scheduled/scheduled.test.ts server/embedding/embedding.test.ts server/python-sdk/python-sdk.test.ts server/analysis/analysis.test.ts server/docgen/docgen.test.ts server/prbot/prbot.test.ts server/redteam/redteam.test.ts",
    "test:upgrading": "node --import tsx --test server/upgrading/upgrading.test.ts",
    "test:teams": "node --import tsx --test server/teams/teams.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test:debugging": "node --import tsx --test server/debugging/debugging.test.ts",
    "test:tool-design": "node --import tsx --test server/tool-design/tool-design.test.ts",
    "eval": "node --env-file-if-exists=.env --import tsx server/evals/cli.ts",
    "test:worktrees": "node --import tsx --test server/worktrees/worktrees.test.ts",
    "test:tool-search": "node --import tsx --test server/tool-search/tool-search.test.ts",
    "test:routing": "node --import tsx --test server/routing/routing.test.ts",
    "test:durable": "node --import tsx --test server/durable/durable.test.ts",
    "test:agent-mcp": "node --import tsx --test server/agent-mcp/agent-mcp.test.ts",
    "test:database": "node --import tsx --test server/database/database.test.ts",
    "test:retrieval": "node --import tsx --test server/retrieval/retrieval.test.ts",
    "test:browser": "node --import tsx --test server/browser/browser.test.ts",
    "test:browser:smoke": "node --env-file-if-exists=.env --import tsx --test server/browser/browser.smoke.test.ts",
    "test:approval": "node --import tsx --test server/approval/approval.test.ts",
    "test:approval:smoke": "node --env-file-if-exists=.env --import tsx --test server/approval/approval.smoke.test.ts",
    "test:realtime": "node --import tsx --test server/realtime/realtime.test.ts",
    "test:realtime:smoke": "node --import tsx --test server/realtime/realtime.smoke.test.ts",
    "test:saas": "node --import tsx --test server/saas/saas.test.ts",
    "test:saas:smoke": "node --import tsx --test server/saas/saas.smoke.test.ts",
    "test:scheduled": "node --import tsx --test server/scheduled/scheduled.test.ts",
    "test:scheduled:smoke": "node --import tsx --test server/scheduled/scheduled.smoke.test.ts",
    "test:embedding": "node --import tsx --test server/embedding/embedding.test.ts",
    "build:extension": "tsc -p ide-extension/tsconfig.host.json",
    "test:embedding:smoke": "node --import tsx --test server/embedding/embedding.smoke.test.ts",
    "test:embedding:extension": "npm run build:extension && node --test scripts/embedding-extension.test.mjs",
    "test:python-sdk": "python -B -m unittest discover -s python-sdk -p test_*.py && node --import tsx --test server/python-sdk/python-sdk.test.ts",
    "test:python-sdk:smoke": "node --import tsx --test server/python-sdk/python-sdk.smoke.test.ts",
    "test:analysis": "node --import tsx --test server/analysis/analysis.test.ts",
    "test:docgen": "node --import tsx --test server/docgen/docgen.test.ts",
    "test:prbot": "node --import tsx --test server/prbot/prbot.test.ts",
    "test:redteam": "node --import tsx --test server/redteam/redteam.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.281",
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@playwright/mcp": "0.0.83",
    "claude-agent-sdk-v2": "npm:@anthropic-ai/claude-agent-sdk@0.2.141",
    "express": "^5.2.1",
    "iconv-lite": "^0.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
