# Copy this file to .env and fill in your key. Never commit .env.
# If ANTHROPIC_API_KEY is empty or missing, the SDK falls back to your Claude Code login.
ANTHROPIC_API_KEY=

# Lesson 70: optional Python interpreter override (executable path, not shell arguments).
# The host uses .venv automatically when present.
PYTHON_SDK_EXECUTABLE=

# Lesson 61: the bearer token outside MCP clients use for the refund desk (/api/c61/mcp). If empty, a random one is made at startup.
REFUND_DESK_TOKEN=

# Lesson 64: optional path to a Chromium browser; installed Chrome is used by default.
PLAYWRIGHT_MCP_EXECUTABLE_PATH=

# Lesson 65: optional real notifications. Default UI delivery is local (no messages sent).
# HTTPS origin serving /api/c65/review, /inspect and /decision, without a path prefix.
APPROVAL_PUBLIC_BASE_URL=
APPROVAL_SLACK_BOT_TOKEN=
APPROVAL_SLACK_CHANNEL=
# A Teams Workflows webhook configured to post the supplied Adaptive Card.
APPROVAL_TEAMS_WORKFLOW_URL=
# Microsoft Graph access token with Mail.Send; refresh outside this sample when expired.
APPROVAL_GRAPH_TOKEN=
APPROVAL_EMAIL_SENDER=
APPROVAL_EMAIL_TO=
