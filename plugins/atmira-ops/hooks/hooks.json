{
  "description": "Audit hooks of atmira-ops: add context at session start, log every tool call, block confidential tickets.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/audit.mjs\"" }] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/audit.mjs\"" }] }
    ]
  }
}
